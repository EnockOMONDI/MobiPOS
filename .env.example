DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=replace-with-a-strong-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
REDIS_URL=redis://localhost:6379/0
BACKGROUND_WORKERS_ENABLED=false
SENTRY_DSN=
INTEGRATION_MODE=sandbox
PRIVILEGED_OTP_REQUIRED=false
POS_AUTO_OPEN_SESSION=true
USERTOUR_ENABLED=false
USERTOUR_DEMO_ONLY=true
USERTOUR_TOKEN=
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///db.sqlite3
DIRECT_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
POOLER_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
EMAIL_DELIVERY_REQUIRED=false
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_RAISE_DELIVERY_ERRORS=false
MAILERSEND_API_TOKEN=
MAILERSEND_API_URL=https://api.mailersend.com/v1/email
EMAIL_MAX_ATTEMPTS=5
EMAIL_CONTENT_RETENTION_DAYS=7
DEFAULT_FROM_EMAIL="MobiPOS <no-reply@example.com>"
APP_BASE_URL=http://127.0.0.1:8000
ACCOUNT_SETUP_TOKEN_DAYS=3

# Encrypted database backups. Keep all real values in Render environment variables.
BACKUP_ENABLED=false
BACKUP_SOURCE_DATABASE_URL=
BACKUP_RESTORE_DATABASE_URL=
BACKUP_RESTORE_PROJECT_REF=
BACKUP_STORAGE_BACKEND=supabase
BACKUP_SUPABASE_URL=
BACKUP_SUPABASE_SERVICE_KEY=
BACKUP_SUPABASE_BUCKET=database-backups
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_RESTORE_DRILL_ENABLED=false
SERVER_EMAIL="MobiPOS <server@example.com>"
SENTRY_REQUIRED=true
SENTRY_DSN=
CSP_REPORT_ONLY_ENABLED=true
# Optional HTTPS endpoint that accepts browser Content Security Policy reports.
CSP_REPORT_URI=
MEDIA_STORAGE_REQUIRED=true
MEDIA_STORAGE_BACKEND=uploadcare
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=
UPLOADCARE_STORE=1
UPLOADCARE_SIGNED_UPLOADS=true
UPLOADCARE_SIGNED_DELIVERY=true
UPLOADCARE_SIGNING_SECRET=
UPLOADCARE_SIGNED_URL_TTL=300
UPLOADCARE_CDN_BASE_URL=https://your-project.s.ucarecd.net
